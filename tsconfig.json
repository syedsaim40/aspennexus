{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "F:\\E-Data\\Freelance Projects\\nexus\\build/types/**/*.ts",
    "build/types/**/*.ts",
    "custom-directory/types/**/*.ts",
    "custom_build/types/**/*.ts",
    "new_build/types/**/*.ts",
    "new_build1/types/**/*.ts",
    "next-env.d.ts",
    "src/app/Components/Gallery.js",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
