# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/custom-directory

# testing
/coverage

# next.js
/.next/cache/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (except .env.example for reference)
.env
.env.*
!.env.example

# vercel
.vercel

